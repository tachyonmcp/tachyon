    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Reproducible builds: fixed for dev builds, overridden with the tag commit time on release -->
        <project.build.outputTimestamp>2026-09-19T00:00:00Z</project.build.outputTimestamp>
        <!-- Published modules override this with their stable JPMS automatic module name -->
        <automatic.module.name>dev.tachyonmcp.internal</automatic.module.name>
        <!-- Java -->
        <java.version>21</java.version>
        <kotlin.version>2.2.21</kotlin.version>
        <kotlin-language.version>2.2</kotlin-language.version>
        <api.oldVersion>1.0.0-beta.30</api.oldVersion>
        <!-- Bound to verify in the modules that declare revapi; needs the baseline from Central, so opt in with -Drevapi.skip=false -->
        <revapi.skip>true</revapi.skip>

        <!-- Dependencies -->
        <assertj.version>3.27.7</assertj.version>
        <awaitility.version>4.3.0</awaitility.version>
