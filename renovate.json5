{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Tachyon's own artifacts are bumped by the release workflow",
      "matchPackageNames": [
        "dev.tachyonmcp"
      ],
      "enabled": false
    },
    {
      "description": "Automatically merge patch-level updates",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Kotlin toolchain moves together: compiler, stdlib, coroutines, serialization. Never merged automatically",
      "groupName": "kotlin",
      "matchPackageNames": [
        "org.jetbrains.kotlin:**",
        "org.jetbrains.kotlinx:**"
      ],
      "automerge": false
    },
    {
      "description": "Jackson 2 and 3 BOMs",
      "groupName": "jackson",
      "matchPackageNames": [
        "com.fasterxml.jackson**",
        "tools.jackson**"
      ]
    },
    {
      "description": "Netty core and the native transports share a version",
      "groupName": "netty",
      "matchPackageNames": [
        "io.netty:**"
      ]
    },
    {
      "description": "Maven 3.10 breaks central-publishing-maven-plugin bundles (mavenplugins/central-publishing-maven-plugin#79); lift once fixed. Maven is never merged automatically: the release depends on its version",
      "matchManagers": [
        "maven-wrapper"
      ],
      "matchDepNames": [
        "maven"
      ],
      "allowedVersions": "<3.10",
      "automerge": false
    },
    {
      "groupName": "junit",
      "matchPackageNames": [
        "org.junit**",
        "org.junit-pioneer:**"
      ]
    },
    {
      "groupName": "spring-boot",
      "matchPackageNames": [
        "org.springframework.boot:**",
        "io.micrometer:**"
      ]
    },
    {
      "groupName": "opentelemetry",
      "matchPackageNames": [
        "io.opentelemetry**"
      ]
    },
    {
      "description": "Build plugins churn often and are low risk together",
      "groupName": "maven-plugins",
      "matchPackageNames": [
        "org.apache.maven.plugins:**",
        "org.codehaus.mojo:**",
        "com.diffplug.spotless:**",
        "com.github.spotbugs:**",
        "org.jacoco:**",
        "org.revapi:**",
        "org.jetbrains.dokka:**",
        "dev.detekt:**"
      ]
    }
  ]
}
